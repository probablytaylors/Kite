fn square(value) {
    return value * value
}

fn cube(value) {
    return value * value * value
}

fn hypotenuse(a, b) {
    return sqrt(square(a) + square(b))
}

fn clamp(value, minimum, maximum) {
    if (value < minimum) {
        return minimum
    }
    if (value > maximum) {
        return maximum
    }
    return value
}
