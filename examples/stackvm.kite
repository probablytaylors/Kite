let OP_HALT = 0
let OP_PUSH = 1
let OP_POP = 2
let OP_DUP = 3
let OP_ADD = 4
let OP_SUB = 5
let OP_MUL = 6
let OP_MOD = 7
let OP_LT = 8
let OP_EQ = 9
let OP_LOAD = 10
let OP_STORE = 11
let OP_JMP = 12
let OP_JZ = 13
let OP_CALL = 14
let OP_RET = 15

fn op_name(op) {
    if (op == OP_HALT) { return "HALT" }
    if (op == OP_PUSH) { return "PUSH" }
    if (op == OP_POP) { return "POP" }
    if (op == OP_DUP) { return "DUP" }
    if (op == OP_ADD) { return "ADD" }
    if (op == OP_SUB) { return "SUB" }
    if (op == OP_MUL) { return "MUL" }
    if (op == OP_MOD) { return "MOD" }
    if (op == OP_LT) { return "LT" }
    if (op == OP_EQ) { return "EQ" }
    if (op == OP_LOAD) { return "LOAD" }
    if (op == OP_STORE) { return "STORE" }
    if (op == OP_JMP) { return "JMP" }
    if (op == OP_JZ) { return "JZ" }
    if (op == OP_CALL) { return "CALL" }
    if (op == OP_RET) { return "RET" }
    return "???"
}

fn zeros(n) {
    let xs = []
    for (let i = 0; i < n; i += 1) {
        append(xs, 0)
    }
    return xs
}

fn set_slot(xs, index, value) {
    let out = []
    for (let i = 0; i < len(xs); i += 1) {
        if (i == index) {
            append(out, value)
        } else {
            append(out, xs[i])
        }
    }
    return out
}

fn disassemble(program) {
    for (let i = 0; i < len(program); i += 1) {
        print(i, op_name(program[i][0]), program[i][1])
    }
}

fn run(program, inputs, trace) {
    let stack = []
    let calls = []
    let mem = zeros(16)
    for (let i = 0; i < len(inputs); i += 1) {
        mem = set_slot(mem, i, inputs[i])
    }

    let pc = 0
    while (pc < len(program)) {
        let op = program[pc][0]
        let arg = program[pc][1]

        if (trace) {
            print("  ", pc, op_name(op), arg, "stack", stack)
        }

        if (op == OP_HALT) {
            if (len(stack) > 0) {
                return stack[len(stack) - 1]
            }
            return 0
        } else if (op == OP_PUSH) {
            append(stack, arg)
            pc += 1
        } else if (op == OP_POP) {
            pop(stack)
            pc += 1
        } else if (op == OP_DUP) {
            append(stack, stack[len(stack) - 1])
            pc += 1
        } else if (op == OP_ADD) {
            let b = pop(stack)
            append(stack, pop(stack) + b)
            pc += 1
        } else if (op == OP_SUB) {
            let b = pop(stack)
            append(stack, pop(stack) - b)
            pc += 1
        } else if (op == OP_MUL) {
            let b = pop(stack)
            append(stack, pop(stack) * b)
            pc += 1
        } else if (op == OP_MOD) {
            let b = pop(stack)
            append(stack, pop(stack) % b)
            pc += 1
        } else if (op == OP_LT) {
            let b = pop(stack)
            let a = pop(stack)
            if (a < b) {
                append(stack, 1)
            } else {
                append(stack, 0)
            }
            pc += 1
        } else if (op == OP_EQ) {
            let b = pop(stack)
            let a = pop(stack)
            if (a == b) {
                append(stack, 1)
            } else {
                append(stack, 0)
            }
            pc += 1
        } else if (op == OP_LOAD) {
            append(stack, mem[arg])
            pc += 1
        } else if (op == OP_STORE) {
            mem = set_slot(mem, arg, pop(stack))
            pc += 1
        } else if (op == OP_JMP) {
            pc = arg
        } else if (op == OP_JZ) {
            if (pop(stack) == 0) {
                pc = arg
            } else {
                pc += 1
            }
        } else if (op == OP_CALL) {
            append(calls, pc + 1)
            pc = arg
        } else if (op == OP_RET) {
            pc = pop(calls)
        } else {
            print("bad opcode", op, "at", pc)
            return 0
        }
    }
    return 0
}

fn fib_program() {
    return [
        [OP_PUSH, 1], [OP_STORE, 2],
        [OP_LOAD, 3], [OP_LOAD, 0], [OP_LT, 0], [OP_JZ, 17],
        [OP_LOAD, 1], [OP_LOAD, 2], [OP_ADD, 0], [OP_LOAD, 2],
        [OP_STORE, 1], [OP_STORE, 2],
        [OP_LOAD, 3], [OP_PUSH, 1], [OP_ADD, 0], [OP_STORE, 3],
        [OP_JMP, 2],
        [OP_LOAD, 1], [OP_HALT, 0]
    ]
}

fn gcd_program() {
    return [
        [OP_LOAD, 1], [OP_JZ, 9],
        [OP_LOAD, 0], [OP_LOAD, 1], [OP_MOD, 0],
        [OP_LOAD, 1], [OP_STORE, 0], [OP_STORE, 1],
        [OP_JMP, 0],
        [OP_LOAD, 0], [OP_HALT, 0]
    ]
}

fn factorial_program() {
    return [
        [OP_LOAD, 0], [OP_CALL, 3], [OP_HALT, 0],
        [OP_DUP, 0], [OP_PUSH, 2], [OP_LT, 0], [OP_JZ, 10],
        [OP_POP, 0], [OP_PUSH, 1], [OP_RET, 0],
        [OP_DUP, 0], [OP_PUSH, 1], [OP_SUB, 0], [OP_CALL, 3], [OP_MUL, 0], [OP_RET, 0]
    ]
}

let fib = fib_program()
let gcd = gcd_program()
let fact = factorial_program()

print("factorial program:")
disassemble(fact)

print("")
let series = []
for (let n = 0; n < 16; n += 1) {
    append(series, run(fib, [n], false))
}
print("fib(0..15) =", series)
print("gcd(1071, 462) =", run(gcd, [1071, 462], false))
print("gcd(270, 192) =", run(gcd, [270, 192], false))
print("6! =", run(fact, [6], false))
print("10! =", run(fact, [10], false))

print("")
print("trace of gcd(48, 18):")
run(gcd, [48, 18], true)
